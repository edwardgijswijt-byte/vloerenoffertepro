{%- comment -%}
  Structured data die Dawn niet levert.

  Dawn zet drie dingen neer: een dunne Organization in header.liquid, een
  WebSite met SearchAction op de startpagina, en op productpagina's
  `{{ product | structured_data }}`. Die laatste dekt naam, prijs,
  beschikbaarheid en url, en verder niets — geen merk, geen sku, geen staat
  van het artikel, geen verzendgegevens. Voor een winkel die uitsluitend
  verzegelde dozen verkoopt is juist `itemCondition` het veld dat telt.

  Wat hier bijkomt:

    Organization    met adres, contact en een vaste @id, zodat elk ander
                    knooppunt ernaar kan verwijzen in plaats van de naam
                    nog eens over te typen. Dat is wat een taalmodel nodig
                    heeft om "Brams Collectibles" als één entiteit te zien
                    en niet als vijf losse vermeldingen.
    Product         volledig, en vervangt die van Dawn. Twee Product-knopen
                    op één pagina levert waarschuwingen op in Search Console,
                    dus de regel in main-product.liquid is weggehaald.
    BreadcrumbList  zat er helemaal niet in. Verschijnt in de zoekresultaten
                    boven de link en is het goedkoopste wat je kunt toevoegen.
    ItemList        op collectiepagina's, zodat de volgorde van de tegels
                    leesbaar is in plaats van een hoop losse links.
    BlogPosting     op de gidsartikelen. Die hadden alleen een kruimelpad, dus
                    een antwoordmachine kon wel de tekst lezen maar niet zien
                    wie hem geschreven heeft of wanneer. Auteur en uitgever
                    wijzen allebei naar de Organization: deze artikelen zijn
                    door de winkel geschreven, niet op naam van een persoon.
                    Het FAQPage-schema staat niet hier maar in de artikeltekst
                    zelf, want de vragen komen uit de markdown-bron.

  Het merk is Pokémon, niet Brams Collectibles. Dat laatste is de verkoper en
  staat als `seller` in de offer. Ze door elkaar halen is een feitelijke fout
  die je in de rijke zoekresultaten terugziet.

  Wat hier bewust NIET staat: `hasMerchantReturnPolicy`. Het retourbeleid is
  nog niet vastgesteld — de waardevermindering-clausule moet eerst langs een
  jurist. Een retourtermijn in de structured data zetten die niet in de
  voorwaarden staat is een toezegging doen die niemand heeft gedaan.
{%- endcomment -%}

{%- liquid
  assign org_id = request.origin | append: '/#organisatie'
  assign site_id = request.origin | append: '/#website'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ org_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }},
      "description": "Verzegelde Pokémon TCG uit eigen voorraad. Elite Trainer Boxen, booster boxes, bundels, displays en cases, waaronder Pokémon Center-uitvoeringen.",
      {%- if settings.logo %}
        "logo": {
          "@type": "ImageObject",
          "url": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }}
        },
      {%- endif %}
      "areaServed": [
        { "@type": "Country", "name": "Nederland" },
        { "@type": "AdministrativeArea", "name": "Europese Unie" }
      ],
      "knowsAbout": [
        "Pokémon Trading Card Game",
        "Verzegelde Pokémon-producten",
        "Elite Trainer Box",
        "Pokémon Center-uitgaven",
        "Booster box",
        "Booster bundle",
        "Verzamelen van Pokémon-kaarten"
      ]
    },
    {
      "@type": "WebSite",
      "@id": {{ site_id | json }},
      "url": {{ request.origin | json }},
      "name": {{ shop.name | json }},
      "inLanguage": "nl-NL",
      "publisher": { "@id": {{ org_id | json }} }
    }

    {%- case request.page_type -%}

    {%- when 'product' -%}
      ,{
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} },
          {%- if collection %}
            { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} },
            { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
          {%- else %}
            { "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }
          {%- endif %}
        ]
      },
      {
        "@type": "Product",
        "@id": {{ request.origin | append: product.url | append: '#product' | json }},
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | truncate: 400 | json }},
        "url": {{ request.origin | append: product.url | json }},
        "brand": { "@type": "Brand", "name": "Pokémon" },
        {%- if product.selected_or_first_available_variant.sku != blank %}
          "sku": {{ product.selected_or_first_available_variant.sku | json }},
        {%- endif %}
        {%- if product.type != blank %}
          "category": {{ product.type | json }},
        {%- endif %}
        {%- comment -%}
          product.images en niet product.media: media kan ook video of een
          3D-model bevatten, en image_url heeft daar niets aan. images geeft
          altijd afbeeldingen.
        {%- endcomment -%}
        "image": [
          {%- for afbeelding in product.images limit: 5 -%}
            {{ afbeelding | image_url: width: 1600 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "offers": {
          "@type": "Offer",
          "url": {{ request.origin | append: product.url | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": {%- if product.selected_or_first_available_variant.available -%}"https://schema.org/InStock"{%- else -%}"https://schema.org/OutOfStock"{%- endif -%},
          "seller": { "@id": {{ org_id | json }} },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "NL" },
            "shippingRate": {
              "@type": "MonetaryAmount",
              "minValue": 6.95,
              "maxValue": 14.95,
              "currency": "EUR"
            }
          }
        }
      }

    {%- when 'collection' -%}
      ,{
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }} }
        ]
      },
      {
        "@type": "CollectionPage",
        "@id": {{ request.origin | append: collection.url | append: '#collectie' | json }},
        "name": {{ collection.title | json }},
        {%- if collection.description != blank %}
          "description": {{ collection.description | strip_html | truncate: 300 | json }},
        {%- endif %}
        "url": {{ request.origin | append: collection.url | json }},
        "isPartOf": { "@id": {{ site_id | json }} },
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": {{ collection.products_count }},
          "itemListElement": [
            {%- for item in collection.products limit: 24 -%}
              {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "url": {{ request.origin | append: item.url | json }},
                "name": {{ item.title | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      }

    {%- when 'article' -%}
      ,{
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ article.title | json }} }
        ]
      }
      ,{
        "@type": "BlogPosting",
        "@id": {{ request.origin | append: article.url | append: '#artikel' | json }},
        "headline": {{ article.title | truncate: 110 | json }},
        "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
        "url": {{ request.origin | append: article.url | json }},
        "mainEntityOfPage": {{ request.origin | append: article.url | json }},
        "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
        "inLanguage": "nl-NL",
        {%- if article.image %}
        "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
        {%- endif %}
        "author": { "@id": {{ org_id | json }} },
        "publisher": { "@id": {{ org_id | json }} },
        "isPartOf": { "@id": {{ site_id | json }} }
      }

    {%- when 'page' -%}
      ,{
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ page.title | json }} }
        ]
      }

    {%- when 'index' -%}
      {%- render 'brams-faq-schema' -%}

    {%- endcase -%}
  ]
}
</script>
