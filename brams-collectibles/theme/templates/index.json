    "loopbalk": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .brams-loop{overflow:hidden;border-block:1px solid rgba(201,162,75,.3)}\n  .brams-loop__spoor{display:flex;width:max-content;animation:brams-loop 38s linear infinite}\n  .brams-loop__reeks{display:flex;flex:none;align-items:center;gap:2.8rem;padding:1.2rem 1.4rem 1.2rem 0;font-family:'Oswald','Arial Narrow',Arial,sans-serif;font-weight:600;font-size:1.25rem;letter-spacing:.22em;text-transform:uppercase;color:#c9a24b;white-space:nowrap}\n  .brams-loop__reeks span::after{content:'\\25C6';margin-left:2.8rem;opacity:.5}\n  @keyframes brams-loop{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n  @media (prefers-reduced-motion:reduce){.brams-loop__spoor{animation:none}}\n</style>\n<div class=\"brams-loop\">\n  <div class=\"brams-loop__spoor\">\n    <div class=\"brams-loop__reeks\"><span>Sealed uit eigen voorraad</span><span>Verzekerd verzonden</span><span>Ophalen op afspraak</span><span>Gestart als fan, voor de verzamelaar</span></div>\n    <div class=\"brams-loop__reeks\" aria-hidden=\"true\"><span>Sealed uit eigen voorraad</span><span>Verzekerd verzonden</span><span>Ophalen op afspraak</span><span>Gestart als fan, voor de verzamelaar</span></div>\n  </div>\n</div>",
        "color_scheme": "scheme-5",
