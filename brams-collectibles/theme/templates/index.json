    "waarborg": {
      "type": "multicolumn",
      "blocks": {
        "voorraad": {
          "type": "column",
          "settings": {
            "title": "Alles ligt hier op de plank",
            "text": "<p>Geen dropshipping, geen pre-orders en geen wachtlijst. Wat je hier ziet staat bij mij thuis in de kast.</p>"
          }
        },
        "sealed": {
          "type": "column",
          "settings": {
            "title": "Sealed en ongeopend",
            "text": "<p>Elke doos is nog dicht en zit in de originele folie. Niet gewogen, niet doorzocht, niet opnieuw geseald.</p>"
          }
        },
        "verzenden": {
          "type": "column",
          "settings": {
            "title": "Verzekerd verzonden",
            "text": "<p>Stevig verpakt en met track &amp; trace. De verzendkosten zijn voor de koper, de zorg komt van ons.</p>"
          }
        },
        "ophalen": {
          "type": "column",
          "settings": {
            "title": "Of kom het halen",
            "text": "<p>Liever zelf even kijken voor je koopt? Ophalen kan op afspraak. Ik maak graag een keer kennis.</p>"
          }
        }
      },
      "block_order": [
        "voorraad",
